{
  "name": "aitranslationenginejp-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wails": "vite --host ${VITE_HOST:-127.0.0.1} --port ${VITE_PORT:-5173} --strictPort",
    "storybook": "storybook dev -p 6008 --exact-port --no-open",
    "build-storybook": "storybook build",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "npm run lint:eslint && npm run lint:types && npm run lint:exports && npm run lint:boundaries",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:types": "tsc --noEmit",
    "lint:exports": "knip --production --include-entry-exports",
    "lint:boundaries": "vitest run --config ./vitest.boundary.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.0",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/svelte-vite": "^10.4.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.8",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.6.1",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.4",
    "daisyui": "^5.5.23",
    "eslint": "^10.2.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "jsdom": "^26.1.0",
    "knip": "^6.3.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "storybook": "^10.4.0",
    "svelte": "^5.37.0",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^5.4.21",
    "vitest": "^4.1.4"
  },
  "knip": {
    "ignore": [
      "src/test/setup.ts",
      "storybook-static/**",
      "src/ui/components/ActionButton.svelte",
      "src/ui/components/ButtonGroup.svelte",
      "src/ui/components/ButtonGroupStoryDemo.svelte",
      "src/ui/components/CheckboxField.svelte",
      "src/ui/components/ConfirmDangerModal.svelte",
      "src/ui/components/EmptyStatePanel.svelte",
      "src/ui/components/FileSelectionDisplay.svelte",
      "src/ui/components/FormField.svelte",
      "src/ui/components/IconActionButton.svelte",
      "src/ui/components/InlineFeedback.svelte",
      "src/ui/components/PaginationControls.svelte",
      "src/ui/components/PhaseMetricCounterGrid.svelte",
      "src/ui/components/ProgressBar.svelte",
      "src/ui/components/SearchFilterBar.svelte",
      "src/ui/components/SelectField.svelte",
      "src/ui/components/StatusPill.svelte",
      "src/ui/components/TextAreaField.svelte",
      "src/ui/components/TextInputField.svelte",
      "src/ui/screens/job-run/job-run-shell-props.ts",
      "src/ui/screens/job-run/__tests__/UntrackEffectProbe.svelte",
      "src/ui/screens/translation-job-setup/CompatibilityPrecheckPanel.svelte",
      "src/ui/screens/translation-job-setup/CreatedJobSummaryPanel.svelte",
      "src/ui/screens/translation-job-setup/FoundationDataPanel.svelte",
      "src/ui/screens/translation-job-setup/InputSourcePanel.svelte",
      "src/ui/screens/translation-job-setup/JobSetupPage.svelte",
      "src/ui/screens/translation-job-setup/JobSetupPurposeHeader.svelte",
      "src/ui/screens/translation-job-setup/PhaseSettingsPanel.svelte",
      "src/ui/screens/translation-job-setup/PhaseSettingsSummaryPanel.svelte",
      "src/ui/screens/translation-job-setup/job-setup-panel-props.ts",
      "src/ui/screens/translation-run/translation-run.fixtures.ts",
      "src/ui/screens/translation-run/TranslationRunNavPreview.svelte",
      "src/ui/screens/template-editor/template-editor.fixtures.ts",
      "src/ui/screens/target-plugins/target-plugins.fixtures.ts",
      "src/ui/screens/target-plugins/TargetPluginsNavPreview.svelte",
      "src/application/diagnostic/frontend-diagnostic-logger.ts",
      "src/application/diagnostic/index.ts",
      "src/ui/stores/shell-state.ts",
      "src/ui/**/__fixtures__/*.ts"
    ],
    "ignoreDependencies": [
      "pino"
    ],
    "ignoreExportsUsedInFile": {
      "interface": true,
      "variable": true
    },
    "ignoreIssues": {},
    "ignoreMembers": [
      "createTranslationJobSetupRuntimeKey",
      "VALIDATION_LABELS",
      "TranslationJobSetupPhaseCardViewModel",
      "TranslationJobSetupSummaryPhaseViewModel",
      "TranslationJobSetupExtendedViewModel",
      "MinimalTranslationRunViewModel"
    ]
  },
  "dependencies": {
    "pino": "^10.3.1"
  }
}
