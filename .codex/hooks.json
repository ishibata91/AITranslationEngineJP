{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_edit_boundary_reminder.py\"",
            "timeout": 5,
            "statusMessage": "edit boundary reminder"
          }
        ]
      }
    ]
  }
}
