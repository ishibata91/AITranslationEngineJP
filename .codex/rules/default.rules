# Project-local Codex rules for AITranslationEngineJP.
# These rules allow workflow validation commands to run outside the sandbox.

prefix_rule(
    pattern = [
        "python3",
        "scripts/harness/run.py",
        "--suite",
        [
            "frontend-lint",
            "backend-lint",
            "frontend-local",
            "backend-local",
            "frontend-test",
            "backend-test",
            "system-test",
            "scenario-gate",
            "coverage",
            "structure",
            "execution",
            "all",
        ],
    ],
    decision = "allow",
    justification = "AITranslationEngineJP harness suites are workflow validation commands.",
    match = [
        "python3 scripts/harness/run.py --suite backend-local",
        "python3 scripts/harness/run.py --suite frontend-local",
        "python3 scripts/harness/run.py --suite all",
    ],
    not_match = [
        "python3 scripts/harness/run.py --suite unknown",
    ],
)

prefix_rule(
    pattern = [
        "npm",
        "run",
        [
            "lint:backend",
            "lint:frontend",
            "frontendlint",
            "test:backend",
            "test:frontend",
            "test:system",
            "test:system:install",
            "test:backend:coverage",
            "test:frontend:coverage",
            "scan:sonar",
            "dev:wails:run",
        ],
    ],
    decision = "allow",
    justification = "Root package scripts are workflow validation and local app commands.",
    match = [
        "npm run test:backend",
        "npm run test:frontend",
        "npm run scan:sonar",
    ],
    not_match = [
        "npm run install",
    ],
)

prefix_rule(
    pattern = [
        "npm",
        "--prefix",
        "frontend",
        "run",
        [
            "lint",
            "test",
            "test:coverage",
            "build",
            "check",
            "lint:eslint",
            "lint:types",
            "lint:exports",
            "lint:boundaries",
            "format:check",
            "storybook",
            "build-storybook",
        ],
    ],
    decision = "allow",
    justification = "Frontend package scripts are workflow validation commands.",
    match = [
        "npm --prefix frontend run lint",
        "npm --prefix frontend run test",
        "npm --prefix frontend run test:coverage",
    ],
    not_match = [
        "npm --prefix frontend run dev",
    ],
)

prefix_rule(
    pattern = [
        "sh",
        [
            "./scripts/test/run-go-backend-test.sh",
            "./scripts/test/run-go-backend-coverage.sh",
            "./scripts/test/run-frontend-coverage.sh",
            "./scripts/test/run-system-test.sh",
            "./scripts/dev/run-wails.sh",
        ],
    ],
    decision = "allow",
    justification = "Repository shell wrappers set workflow-safe cache and test defaults.",
    match = [
        "sh ./scripts/test/run-go-backend-test.sh",
        "sh ./scripts/test/run-system-test.sh",
    ],
    not_match = [
        "sh ./scripts/test/unknown.sh",
    ],
)

prefix_rule(
    pattern = [
        "sh",
        "./scripts/lint/run-go-backend-lint.sh",
        [
            "format-check",
            "vet",
            "static",
            "arch",
            "module",
            "packages",
        ],
    ],
    decision = "allow",
    justification = "Backend lint wrapper is part of the workflow validation gate.",
    match = [
        "sh ./scripts/lint/run-go-backend-lint.sh vet",
        "sh ./scripts/lint/run-go-backend-lint.sh static",
    ],
    not_match = [
        "sh ./scripts/lint/run-go-backend-lint.sh unknown",
    ],
)

prefix_rule(
    pattern = [
        "go",
        [
            "test",
            "vet",
            "list",
            "run",
        ],
    ],
    decision = "allow",
    justification = "Go test, vet, list, and tool runners are required by backend validation.",
    match = [
        "go test ./internal/...",
        "go vet ./internal/...",
        "go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.3.0 run --config .golangci.yml ./internal/...",
    ],
    not_match = [
        "go env -w GOPROXY=off",
    ],
)

prefix_rule(
    pattern = [
        "go",
        "tool",
        "cover",
    ],
    decision = "allow",
    justification = "Go coverage summary generation is required by backend coverage validation.",
    match = [
        "go tool cover -func=test-results/backend-coverage/coverage.out",
    ],
    not_match = [
        "go tool pprof",
    ],
)

prefix_rule(
    pattern = [
        "gofmt",
        "-l",
        "internal",
    ],
    decision = "allow",
    justification = "Backend format check is part of the lint gate.",
    match = [
        "gofmt -l internal",
    ],
    not_match = [
        "gofmt -w internal",
    ],
)

prefix_rule(
    pattern = [
        "npx",
        "playwright",
        "test",
    ],
    decision = "allow",
    justification = "Playwright system tests are workflow validation commands.",
    match = [
        "npx playwright test --config ./playwright.config.ts",
    ],
    not_match = [
        "npx playwright install chromium",
    ],
)

prefix_rule(
    pattern = [
        "wails",
        "dev",
    ],
    decision = "allow",
    justification = "Wails dev server is required by the system-test workflow.",
    match = [
        "wails dev -devserver localhost:34115",
    ],
    not_match = [
        "wails build",
    ],
)

prefix_rule(
    pattern = [
        "pkill",
        "-f",
        "storybook dev -p 6008 --exact-port --no-open",
    ],
    decision = "allow",
    justification = "Storybook review uses one fixed dev server on port 6008 and requires restart after frontend or story changes.",
    match = [
        "pkill -f \"storybook dev -p 6008 --exact-port --no-open\"",
    ],
    not_match = [
        "pkill -f node",
        "pkill -f storybook",
    ],
)

prefix_rule(
    pattern = [
        "node",
        "./scripts/node/run-sonar-scanner.mjs",
    ],
    decision = "allow",
    justification = "Sonar scanner wrapper fixes repo-local validation environment defaults.",
    match = [
        "node ./scripts/node/run-sonar-scanner.mjs",
    ],
    not_match = [
        "node ./scripts/node/unknown.mjs",
    ],
)

prefix_rule(
    pattern = [
        "git",
        [
            "status",
            "branch",
            "diff",
            "log",
        ],
    ],
    decision = "allow",
    justification = "Local git inspection commands are required for branch lane operation.",
    match = [
        "git status --short",
        "git branch",
        "git diff --stat",
        "git log --oneline -5",
    ],
    not_match = [
        "git push",
    ],
)

prefix_rule(
    pattern = [
        "git",
        "switch",
    ],
    decision = "allow",
    justification = "Local branch selection is required for active plan branch operation.",
    match = [
        "git switch master",
        "git switch -c codex/task-id",
    ],
    not_match = [
        "git checkout -- file",
    ],
)

prefix_rule(
    pattern = [
        "git",
        [
            "add",
            "commit",
        ],
    ],
    decision = "allow",
    justification = "Local commits are required before merge lane handoff.",
    match = [
        "git add .codex/README.md",
        "git commit -m update-workflow-contract",
    ],
    not_match = [
        "git push",
    ],
)

prefix_rule(
    pattern = [
        "git",
        "merge",
        "--no-ff",
    ],
    decision = "allow",
    justification = "Merge lane performs local non-fast-forward merges only.",
    match = [
        "git merge --no-ff codex/task-id",
    ],
    not_match = [
        "git merge origin/master",
    ],
)

prefix_rule(
    pattern = [
        "git",
        [
            "push",
            "clean",
        ],
    ],
    decision = "forbidden",
    justification = "Agents must not change remote repositories or run destructive cleanup commands.",
    match = [
        "git push",
        "git clean -fd",
    ],
    not_match = [
        "git status --short",
    ],
)

prefix_rule(
    pattern = [
        "git",
        "reset",
        "--hard",
    ],
    decision = "forbidden",
    justification = "Agents must not discard local changes.",
    match = [
        "git reset --hard",
    ],
    not_match = [
        "git reset --soft HEAD~1",
    ],
)

prefix_rule(
    pattern = [
        "git",
        "checkout",
        "--",
    ],
    decision = "forbidden",
    justification = "Agents must not discard file changes with checkout.",
    match = [
        "git checkout -- .",
    ],
    not_match = [
        "git switch master",
    ],
)
