      "kind": "ui_state_transition",
      "source_requirement": "docs/screen-design/screens/master-persona.md の進行状況パネル。UX-standard の状態表示と状態別操作。",
      "required_detail_types": [
        "success_requirement",
        "failure_handling_requirement",
        "state_requirement",
        "consistency_requirement",
        "recovery_requirement",
        "testability_requirement"
      ],
      "detail_requirements": [
        {
          "type": "success_requirement",
          "status": "explicit",
          "source_or_rationale": "生成中は進捗、件数、現在対象、一時停止、中止を表示する。",
          "verification_hint": "SCN-MPC-003"
        },
        {
          "type": "failure_handling_requirement",
          "status": "derived",
          "source_or_rationale": "生成状態取得失敗、一時停止失敗、中止失敗を成功表示へ変えない。",
          "verification_hint": "SCN-MPC-003"
        },
        {
          "type": "state_requirement",
          "status": "explicit",
          "source_or_rationale": "生成中だけ一時停止と中止を有効にし、生成中は編集、削除、再生成を拒否する。",
          "verification_hint": "SCN-MPC-003"
        },
        {
          "type": "consistency_requirement",
          "status": "derived",
          "source_or_rationale": "`isRunActive` と `canMutate` が進行状況、詳細操作、作成開始可否と矛盾してはならない。",
          "verification_hint": "SCN-MPC-003"
        },
        {
          "type": "recovery_requirement",
          "status": "derived",
          "source_or_rationale": "失敗後は直前に観測できていた進行状態を勝手に完了扱いにせず、同じ段階へ戻れる表示を保つ。",
          "verification_hint": "SCN-MPC-003"
        },
        {
          "type": "observability_requirement",
          "status": "derived",
          "source_or_rationale": "生成中 story は処理済み件数、作成済み件数、既存スキップ数、現在対象、操作可否を後追い確認できる。",
          "verification_hint": "SCN-MPC-003, SCN-MPC-007"
        },
        {
          "type": "testability_requirement",
          "status": "derived",
          "source_or_rationale": "生成中、生成失敗、生成完了を fixture と story で分けて検査する。",
          "verification_hint": "SCN-MPC-003"
        }
      ]
    },
