@startuml
title ページ別コンポーネント分割図: 共通部品方針

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam nodesep 55
skinparam ranksep 70

skinparam component {
  BackgroundColor<<page>> #FFF8E1
  BorderColor<<page>> #F9A825
  FontColor<<page>> #4E342E
  BackgroundColor<<local>> #EEF9EF
  BorderColor<<local>> #2E7D32
  FontColor<<local>> #1B5E20
  BackgroundColor<<shared>> #E3F2FD
  BorderColor<<shared>> #1565C0
  FontColor<<shared>> #0D47A1
  BackgroundColor<<candidate>> #F3E5F5
  BorderColor<<candidate>> #7B1FA2
  FontColor<<candidate>> #4A148C
  BackgroundColor<<keep>> #F7F9FC
  BorderColor<<keep>> #546E7A
  FontColor<<keep>> #263238
}

legend bottom right
  |= Style |= 意味 |
  |<#FFF8E1> page | page component。controller 接続、購読、dispose、通知、表示部品合成を担当する |
  |<#EEF9EF> local | 画面専用 component。画面固有の panel、card、modal、list、detail を担当する |
  |<#E3F2FD> shared | 共通 component。複数画面で同じ表示規則または操作規則を担う |
  |<#F3E5F5> candidate | 共通候補。props 分岐が増える場合は画面専用へ戻す |
  |<#F7F9FC> keep | 分けない対象。controller、bridge、状態集約、routing を page 側に残す |
endlegend

package "共通 component: frontend/src/ui/components/" as SharedLayer {
  component "AIModelSelectionCard\nAI model 選択カード" as AIModelSelectionCard <<shared>>
  component "StickyActionFooter\n固定フッター操作" as StickyActionFooter <<shared>>

  component "ActionButton\nprimary / secondary / danger" as ActionButton <<candidate>>
  component "ButtonGroup\n操作群の並びと間隔" as ButtonGroup <<candidate>>
  component "IconActionButton\nrefresh / reset / close など" as IconActionButton <<candidate>>
  component "FormField\nlabel / help / error / required" as FormField <<candidate>>
  component "TextInputField\ntext / password / path 表示" as TextInputField <<candidate>>
  component "TextAreaField\n長文編集" as TextAreaField <<candidate>>
  component "SelectField\nプルダウン" as SelectField <<candidate>>
  component "CheckboxField\ncheckbox と説明文" as CheckboxField <<candidate>>
  component "SearchFilterBar\n検索 input と filter select" as SearchFilterBar <<candidate>>
  component "FileSelectionDisplay\nfile 名 / path label / hash label" as FileSelectionDisplay <<candidate>>
  component "InlineFeedback\nerror / warning / success" as InlineFeedback <<candidate>>
  component "EmptyStatePanel\n空状態表示" as EmptyStatePanel <<candidate>>
  component "ProgressBar\n進捗表示" as ProgressBar <<candidate>>
  component "StatusPill\n状態ラベル" as StatusPill <<candidate>>
  component "ConfirmDangerModal\n危険操作確認 modal" as ConfirmDangerModal <<candidate>>
  component "PaginationControls\nページング操作" as PaginationControls <<candidate>>
  component "PhaseStatusPanel\nphase 状態表示" as PhaseStatusPanel <<candidate>>
  component "PhaseActionPanel\nphase 操作群" as PhaseActionPanel <<candidate>>
  component "PhaseProgressPanel\nphase 進捗表示" as PhaseProgressPanel <<candidate>>
  component "PhaseFailureInfoCard\nphase 失敗情報" as PhaseFailureInfoCard <<candidate>>
  component "PhaseMetricCounterGrid\nphase 指標一覧" as PhaseMetricCounterGrid <<candidate>>
  component "PhaseNavigationFooter\nphase 間 navigation" as PhaseNavigationFooterShared <<candidate>>
}

component "共通化判断\n複数画面で同じ表示規則または操作規則を持つ場合だけ shared に置く" as SharedRule <<keep>>
component "戻し判断\nprops が画面固有条件の塊になる場合は screen local に戻す" as SharedRollback <<keep>>

SharedRule ..> AIModelSelectionCard
SharedRule ..> StickyActionFooter
SharedRule ..> ActionButton
SharedRule ..> ButtonGroup
SharedRule ..> IconActionButton
SharedRule ..> FormField
SharedRule ..> TextInputField
SharedRule ..> TextAreaField
SharedRule ..> SelectField
SharedRule ..> CheckboxField
SharedRule ..> SearchFilterBar
SharedRule ..> FileSelectionDisplay
SharedRule ..> InlineFeedback
SharedRule ..> EmptyStatePanel
SharedRule ..> ProgressBar
SharedRule ..> StatusPill
SharedRule ..> ConfirmDangerModal
SharedRule ..> PaginationControls
SharedRule ..> PhaseStatusPanel
SharedRule ..> PhaseActionPanel
SharedRule ..> PhaseProgressPanel
SharedRule ..> PhaseFailureInfoCard
SharedRule ..> PhaseMetricCounterGrid
SharedRule ..> PhaseNavigationFooterShared

SharedRollback ..> StatusPill
SharedRollback ..> ConfirmDangerModal
SharedRollback ..> SearchFilterBar
SharedRollback ..> FileSelectionDisplay
SharedRollback ..> PhaseStatusPanel
SharedRollback ..> PhaseActionPanel
SharedRollback ..> PhaseProgressPanel
SharedRollback ..> PhaseFailureInfoCard
SharedRollback ..> PhaseMetricCounterGrid
SharedRollback ..> PhaseNavigationFooterShared

note bottom of SharedLayer
共通 component は Storybook story を持つ。
story は fixed props、view model fixture、callback stub だけを使う。
backend DTO、Gateway、generated wailsjs、RuntimeEventAdapter、secret store、DB、実 filesystem flow は扱わない。
file picker や secret 保存そのものは共通 component に入れない。
共通 input は value、disabled、error、help、callback だけを扱う。
end note

@enduml

