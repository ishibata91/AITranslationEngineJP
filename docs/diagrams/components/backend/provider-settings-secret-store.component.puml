@startuml

title provider settings secret store component detail

' Source of truth:
' - docs/architecture.md
' - docs/detail-specs/ai-provider-settings-management.md
' - internal/controller/wails/provider_settings_controller.go
' - internal/usecase/provider_settings_usecase.go
' - internal/service/provider_settings_service.go
' - internal/repository/provider_settings_repository.go
' - internal/repository/provider_settings_keyring_secret_store.go

top to bottom direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 50
skinparam ranksep 60
skinparam ArrowFontSize 11

skinparam package {
    BackgroundColor #f7f9fc
    BorderColor #546e7a
    FontColor #243447
}
skinparam component {
    BackgroundColor #ffffff
    BorderColor #546e7a
    FontColor #243447
}
skinparam database {
    BackgroundColor #fff8e1
    BorderColor #8d6e63
    FontColor #3e2723
}
skinparam collections {
    BackgroundColor #eef9ef
    BorderColor #2e7d32
    FontColor #1b5e20
}

package "Frontend transport" as FrontendTransport {
    component "ProviderSettingsPage / ScreenController" as ProviderSettingsScreen
    component "Gateway\nSaveProviderSettings(request)" as ProviderSettingsGateway
}

package "Backend" as BackendBoundary {
    component "Controller\nProviderSettingsController" as ProviderSettingsController
    component "Backend UseCase\nProviderSettingsAppUsecase" as ProviderSettingsUsecase
    component "Service\nProviderSettingsService" as ProviderSettingsService
}

package "Adapter" as AdapterBoundary {
    component "ProviderSettingsRepository port" as ProviderSettingsRepositoryPort
    component "ProviderSettingsSecretStore port" as ProviderSettingsSecretStorePort
    component "SQLite repository adapter" as SQLiteRepository
    component "CachedProviderSettingsSecretStore" as CachedSecretStore
    component "ProviderSettingsKeyringSecretStore" as KeyringSecretStore
}

package "External storage" as ExternalStorage {
    database "SQLite\nprovider_settings row\nsecret value is not stored" as ProviderSettingsTable
    collections "OS keyring backend\nKeychain / WinCred / file backend" as OSKeyring
}

ProviderSettingsScreen --> ProviderSettingsGateway : endpoint and transient API key input
ProviderSettingsGateway --> ProviderSettingsController : Wails Bind
ProviderSettingsController --> ProviderSettingsUsecase : SaveProviderSettingsWithSecret when credentialInput exists
ProviderSettingsUsecase --> ProviderSettingsService : ProviderSettingsSaveInput

ProviderSettingsService --> ProviderSettingsRepositoryPort : Upsert row
ProviderSettingsService --> ProviderSettingsSecretStorePort : Save stage and canonical secret
ProviderSettingsRepositoryPort <|.. SQLiteRepository
ProviderSettingsSecretStorePort <|.. CachedSecretStore
ProviderSettingsSecretStorePort <|.. KeyringSecretStore

SQLiteRepository --> ProviderSettingsTable : provider_id, endpoint, credential_reference_id, credential_state
CachedSecretStore --> KeyringSecretStore : delegated Save / Load / Delete
KeyringSecretStore --> OSKeyring : keyring.Item data

note right of ProviderSettingsController
  credentialInput は controller で一時入力として受ける。
  response DTO は credentialState と credentialReferenceId だけを返す。
end note

note bottom of ProviderSettingsService
  APIキー保存は補償単位で扱う。
  先に stage secret を保存し、DB row を upsert し、
  最後に canonical secret を保存する。
end note

note bottom of ProviderSettingsTable
  DB は APIキー平文と復号可能値を保持しない。
end note

@enduml
